    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.1.13",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
